# ══════════════════════════════════════════
# .env — Secrets & Konfiguration
# Kopiere diese Datei zu .env und fülle aus
# NIEMALS in Git committen!
# ══════════════════════════════════════════

# ── Postgres ──────────────────────────────
POSTGRES_PASSWORD=dein-sicheres-passwort-hier

# ── Supabase ──────────────────────────────
# Generieren: openssl rand -base64 32
JWT_SECRET=dein-jwt-secret-min-32-zeichen-lang
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site URL ──────────────────────────────
# Lokal:
SITE_URL=http://localhost
# Produktion (Cloudflare Domain eintragen):
# SITE_URL=https://deine-domain.com

ADDITIONAL_REDIRECT_URLS=

# ── Backend ───────────────────────────────
# Generieren: openssl rand -hex 32
BACKEND_SECRET_KEY=dein-backend-secret-key

# ── n8n ───────────────────────────────────
# Generieren: openssl rand -hex 24
N8N_ENCRYPTION_KEY=dein-n8n-encryption-key

# ── E-Mail ────────────────────────────────
# Lokal: Mailpit fängt alle Mails ab (kein Setup nötig)
# Produktion: Werte auf Resend / Postmark anpassen
SMTP_SENDER_NAME=Meine SaaS App
MAILER_AUTOCONFIRM=false

# ── Signup ────────────────────────────────
DISABLE_SIGNUP=false
